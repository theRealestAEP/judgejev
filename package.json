{
  "name": "judge-jev",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 3000 --strictPort",
    "build": "tsc --noEmit && vite build",
    "start": "vite preview",
    "lint": "oxlint",
    "format": "oxfmt",
    "test": "node --experimental-strip-types --test server/*.test.ts",
    "typecheck": "tsc --noEmit",
    "evaluate": "node --experimental-strip-types scripts/evaluate.ts",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "lucide-react": "1.31.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.56.0",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "wrangler": "4.135.0"
  },
  "type": "module"
}
